<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_global_background">
    <ImageView android:id="@+id/btnSetupBack" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="14dp" android:padding="12dp"
        android:src="@android:drawable/ic_menu_revert" app:tint="@color/main_text" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="تنظیم کارنامه" android:textColor="@color/title_blue" android:textSize="20sp" android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btnSetupBack" app:layout_constraintBottom_toBottomOf="@id/btnSetupBack" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" app:layout_constraintTop_toBottomOf="@id/btnSetupBack"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layoutDirection="rtl" android:padding="20dp">
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="کلاس">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/dropdownClassTarget" android:layout_width="match_parent" android:layout_height="54dp"
                    android:gravity="right|center_vertical" android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/txtSelectedClassInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:gravity="right" android:text="کلاس را انتخاب کنید" android:textColor="@color/sub_text" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="right"
                android:text="معیارهای نمره‌دهی" android:textColor="@color/main_text" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="right"
                android:text="حداکثر ۸ معیار؛ بعد از افزودن هر معیار بارم آن را مشخص کنید." android:textColor="@color/sub_text" android:textSize="12sp" />
            <LinearLayout android:id="@+id/containerFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAddCriterion" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content" android:layout_height="42dp" android:layout_gravity="end" android:layout_marginTop="8dp"
                android:text="افزودن معیار" android:textAllCaps="false" app:icon="@android:drawable/ic_input_add" />
            <TextView android:id="@+id/txtTotalSumValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:gravity="right" android:text="مجموع بارم: ۰ از ۱۰۰" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="right"
                android:text="مرزهای نتیجه برای نمره کمتر از ۸۳" android:textColor="@color/main_text" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:weightSum="2">
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="حد قبولی بدون ستاره">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPassNoStarMin" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="حد مشروطی">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etConditionalMin" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnEditResultMessages" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="18dp"
                android:text="ویرایش متن هشت وضعیت" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveLayout" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp"
                android:text="ذخیره و ورود نمرات" android:textAllCaps="false" app:cornerRadius="13dp" />
            <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progressReportSetup" android:layout_width="36dp" android:layout_height="36dp"
                android:layout_gravity="center" android:layout_marginTop="12dp" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
