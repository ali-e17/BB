<?xml version='1.0' encoding='UTF-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/rootReportCardSetup" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_global_background" android:layoutDirection="rtl">
  <com.google.android.material.card.MaterialCardView android:id="@+id/topBarSetup" android:layout_width="0dp" android:layout_height="64dp" android:layout_marginStart="20dp" android:layout_marginTop="16dp" android:layout_marginEnd="20dp" app:cardBackgroundColor="@color/card_background" app:cardCornerRadius="20dp" app:cardElevation="8dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
      <ImageView android:id="@+id/btnSetupBack" android:layout_alignParentLeft="true" android:layout_centerVertical="true" style="@style/AppBackButton"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="تنظیم کارنامه" android:textColor="@color/title_blue" android:textSize="18sp" android:textStyle="bold"/>
    </RelativeLayout>
  </com.google.android.material.card.MaterialCardView>
  <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:fillViewport="true" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/topBarSetup">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="14dp" android:paddingEnd="18dp" android:paddingBottom="28dp">
      <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/card_background" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:strokeColor="#203559B8" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="12dp">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="۱  انتخاب کلاس" android:textColor="@color/title_blue" android:textSize="11sp" android:textStyle="bold"/>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="←" android:textColor="@color/sub_text" android:textSize="15sp"/>
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="۲  تنظیم معیارها" android:textColor="@color/brand_orange" android:textSize="11sp" android:textStyle="bold"/>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="←" android:textColor="@color/sub_text" android:textSize="15sp"/>
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="۳  ثبت نمرات" android:textColor="@color/sub_text" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <TextView
        style="@style/UnifiedFormLabel"
        android:layout_marginTop="18dp"
        android:text="انتخاب کلاس" />
      <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="13dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/brand_orange"
        app:strokeWidth="1dp">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
          android:id="@+id/dropdownClassTarget"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@android:color/transparent"
          android:clickable="true"
          android:cursorVisible="false"
          android:drawableEnd="@drawable/ic_arrow_down_clean"
          android:drawablePadding="10dp"
          android:focusable="true"
          android:gravity="right|center_vertical"
          android:hint="یک کلاس را انتخاب کنید"
          android:inputType="none"
          android:maxLines="1"
          android:paddingStart="14dp"
          android:paddingEnd="14dp"
          android:textColor="@color/main_text"
          android:textColorHint="@color/hint_color"
          android:textDirection="rtl"
          android:textSize="14sp" />
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/card_background" app:cardCornerRadius="14dp" app:cardElevation="1dp" app:strokeColor="#203559B8" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
          <TextView android:id="@+id/txtSelectedClassInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="right" android:lineSpacingExtra="2dp" android:text="لطفاً کلاس مورد نظر خود را انتخاب کنید" android:textColor="@color/main_text" android:textDirection="rtl" android:textSize="13sp"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <TextView android:id="@+id/txtPassRule" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_input_field" android:gravity="center" android:minHeight="42dp" android:padding="8dp" android:text="حد قبولی: —" android:textColor="@color/title_blue" android:textSize="11sp" android:textStyle="bold"/>
            <View android:layout_width="8dp" android:layout_height="1dp"/>
            <TextView android:id="@+id/txtConditionalRule" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_input_field" android:gravity="center" android:minHeight="42dp" android:padding="8dp" android:text="حد مشروطی: —" android:textColor="@color/brand_orange" android:textSize="11sp" android:textStyle="bold"/>
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView android:id="@+id/cardTotalSum" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/card_background" app:cardCornerRadius="14dp" app:cardElevation="2dp" app:strokeColor="#203559B8" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="right" android:text="مجموع بارم‌ها" android:textColor="@color/main_text" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:id="@+id/txtTotalSumValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 / 100" android:textColor="#EF4444" android:textSize="20sp" android:textStyle="bold"/>
          </LinearLayout>
          <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progressTotalScore" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="10dp" android:max="100" android:progress="0" app:indicatorColor="@color/brand_orange" app:trackColor="#E9EEF7" app:trackCornerRadius="4dp"/>
          <TextView android:id="@+id/txtTotalHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="right" android:text="مجموع باید دقیقاً ۱۰۰ باشد" android:textColor="@color/sub_text" android:textSize="11sp"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="right" android:text="معیارهای نمره‌دهی" android:textColor="@color/main_text" android:textSize="16sp" android:textStyle="bold"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="right" android:text="بین ۱ تا ۸ معیار تعریف کنید. نام معیارها باید یکتا و مجموع بارم‌ها دقیقاً ۱۰۰ باشد." android:textColor="@color/sub_text" android:textSize="12sp"/>
      <LinearLayout android:id="@+id/containerFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnAddCriterion" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_gravity="left" android:layout_marginTop="10dp" android:text="افزودن معیار جدید" android:textAllCaps="false" android:textColor="@color/title_blue" android:textSize="12sp" app:cornerRadius="11dp" app:icon="@android:drawable/ic_input_add" app:iconTint="@color/title_blue" app:strokeColor="@color/title_blue"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnEditResultMessages" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="20dp" android:text="ویرایش متن پیام‌های نتیجه" android:textAllCaps="false" android:textColor="@color/title_blue" android:textSize="13sp" app:cornerRadius="12dp" app:strokeColor="@color/title_blue"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveLayout" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:backgroundTint="@color/brand_orange" android:text="ذخیره و ورود به لیست نمرات" android:textAllCaps="false" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="14dp"/>
      <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/progressReportSetup" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:layout_marginTop="16dp" android:visibility="gone" app:indicatorColor="@color/brand_orange"/>
    </LinearLayout>
  </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
