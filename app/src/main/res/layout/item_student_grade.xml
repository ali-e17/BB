<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#243559B8"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minWidth="62dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="آماده"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtStudentName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:breakStrategy="simple"
                    android:gravity="right|center_vertical"
                    android:hyphenationFrequency="none"
                    android:maxLines="2"
                    android:minHeight="40dp"
                    android:text="نام و نام خانوادگی دانش‌آموز"
                    android:textColor="@color/main_text"
                    android:textDirection="rtl"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="#183559B8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnPreviewCard"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_report_action_button"
                    android:contentDescription="مشاهده کارنامه"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_view"
                    app:tint="@color/title_blue" />

                <ImageView
                    android:id="@+id/imgExpandArrow"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/bg_report_action_button"
                    android:contentDescription="باز و بسته کردن"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_down_clean"
                    app:tint="@color/brand_orange" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtStudentCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="کد: —"
                        android:textColor="@color/sub_text"
                        android:textSize="10.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="7dp"
                        android:text="•"
                        android:textColor="@color/sub_text"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/txtStudentTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="نمره فعلی: 0"
                        android:textColor="@color/title_blue"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/expandableBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#080F40D1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/containerGrades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/txtExpandedTotal"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_report_expanded_total"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="جمع نمره‌های واردشده: 0 از 100"
                android:textColor="@color/title_blue"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
