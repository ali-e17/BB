<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="4dp" android:layout_marginVertical="5dp" android:layoutDirection="rtl" app:cardBackgroundColor="@color/card_background" app:cardCornerRadius="14dp" app:cardElevation="1dp" app:strokeColor="#1A64748B" app:strokeWidth="1dp">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp" android:padding="12dp">
        <!--  آواتار دانش‌آموز؛ دقیقاً در سمت راست کارت  -->
        <FrameLayout android:id="@+id/studentAvatarContainer" android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/bg_circle_icon" android:backgroundTint="@color/bg_blue_light" android:backgroundTintMode="src_atop" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintRight_toRightOf="parent" app:layout_constraintTop_toTopOf="parent">
            <ImageView android:id="@+id/ivStudentAvatar" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center" android:contentDescription="آواتار دانش‌آموز" android:scaleType="centerInside" android:src="@drawable/avatar_student_1"/>
        </FrameLayout>
        <!--  دکمه عملیات در سمت چپ کارت  -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAction" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="76dp" android:text="افزودن" android:textSize="12sp" app:cornerRadius="11dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintTop_toTopOf="parent" app:strokeColor="@color/brand_orange"/>
        <!--  نام و جزئیات بین آواتار و دکمه  -->
        <LinearLayout android:id="@+id/studentInfoContainer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="10dp" android:layout_marginRight="12dp" android:gravity="center_vertical|right" android:orientation="vertical" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintLeft_toRightOf="@id/btnAction" app:layout_constraintRight_toLeftOf="@id/studentAvatarContainer" app:layout_constraintTop_toTopOf="parent">
            <TextView android:id="@+id/tvStudentName" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="right" android:maxLines="2" android:text="نام دانش‌آموز" android:textColor="@color/main_text" android:textDirection="rtl" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvStudentPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="right" android:maxLines="3" android:text="اطلاعات دانش‌آموز" android:textColor="@color/sub_text" android:textDirection="rtl" android:textSize="12sp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>