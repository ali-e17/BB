<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="#203559B8"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/txtComponentNumber"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_role_badge"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/title_blue"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:hint="نام معیار"
            app:boxStrokeColor="@color/title_blue">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etComponentTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:maxLines="2"
                android:textColor="@color/input_text"
                android:textDirection="firstStrong" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:hint="بارم"
            app:boxStrokeColor="@color/brand_orange">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etComponentMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textColor="@color/input_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <ImageView
            android:id="@+id/btnRemoveComponent"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="حذف معیار"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#B42318" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
