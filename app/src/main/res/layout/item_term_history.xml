<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp" android:layout_marginVertical="6dp" app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp" app:strokeWidth="1dp" app:strokeColor="#1F667085">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layoutDirection="rtl" android:padding="16dp">
        <TextView android:id="@+id/txtHistoryTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="right"
            android:maxLines="2" android:ellipsize="end" android:textColor="@color/main_text" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/txtHistoryMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp"
            android:gravity="right" android:textColor="@color/sub_text" android:textSize="12sp" />
        <TextView android:id="@+id/txtHistoryStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:gravity="right" android:textColor="@color/main_text" android:textSize="12sp" />
        <TextView android:id="@+id/txtHistoryResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field" android:gravity="center" android:padding="10dp" android:textColor="@color/title_blue"
            android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
