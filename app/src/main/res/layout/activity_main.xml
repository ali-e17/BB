<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/app_global_background" android:layoutDirection="rtl">
    <com.google.android.material.card.MaterialCardView android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginHorizontal="20dp" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/card_background" app:cardCornerRadius="20dp" app:cardElevation="12dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:strokeWidth="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="8dp">
            <!--  لوگوی آموزشگاه: سمت راست Top Bar  -->
            <ImageView android:id="@+id/imgTopBarLogo" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_circle_white" android:contentDescription="لوگوی آموزشگاه بیان برتر" android:padding="5dp" android:src="@drawable/final50cm" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintRight_toRightOf="parent" app:layout_constraintTop_toTopOf="parent"/>
            <!--  عنوان دقیقاً در فضای میانی Top Bar  -->
            <TextView android:id="@+id/txtTopBarSchoolName" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="6dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="true" android:contentDescription="باز کردن سایت آموزشگاه بیان برتر" android:ellipsize="end" android:focusable="true" android:gravity="center" android:maxLines="1" android:text="آموزشگاه زبان خارجی بیان برتر" android:textAlignment="center" android:textColor="@color/title_blue" android:textDirection="rtl" android:textSize="17sp" android:textStyle="bold" app:autoSizeMaxTextSize="17sp" app:autoSizeMinTextSize="12sp" app:autoSizeStepGranularity="1sp" app:autoSizeTextType="uniform" app:layout_constraintLeft_toRightOf="@id/btnProfile" app:layout_constraintRight_toLeftOf="@id/imgTopBarLogo" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
            <!--  پروفایل: کمی بزرگ‌تر و سمت چپ Top Bar  -->
            <ImageView android:id="@+id/btnProfile" android:layout_width="52dp" android:layout_height="52dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="true" android:contentDescription="پروفایل" android:focusable="true" android:padding="10dp" android:src="@drawable/ic_profile" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="@color/main_text"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/greetingSection" android:layout_width="0dp" android:layout_height="wrap_content" android:paddingStart="24dp" android:paddingTop="18dp" android:paddingEnd="24dp" android:paddingBottom="16dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/topBar">
        <LinearLayout android:id="@+id/layoutGreetingText" android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="right" android:orientation="vertical" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintRight_toRightOf="parent" app:layout_constraintLeft_toRightOf="@id/layoutHeaderActions" app:layout_constraintTop_toTopOf="parent">
            <TextView android:id="@+id/txtGreeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="right" android:text="صبح بخیر،" android:textColor="@color/sub_text" android:textDirection="rtl" android:textSize="14sp"/>
            <TextView android:id="@+id/txtUserName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="right" android:maxLines="1" android:text="کاربر عزیز" android:textColor="@color/main_text" android:textDirection="rtl" android:textSize="23sp" android:textStyle="bold"/>
            <TextView android:id="@+id/txtRoleBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="right" android:layout_marginTop="7dp" android:background="@drawable/bg_unified_info_badge" android:text="نقش" android:textColor="@color/title_blue" android:textDirection="rtl" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/layoutHeaderActions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:layoutDirection="ltr" android:orientation="horizontal" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintTop_toTopOf="parent">
            <ImageView android:id="@+id/btnThemeToggle" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_header_control" android:clickable="true" android:focusable="true" android:padding="10dp" android:src="@drawable/ic_moon" app:tint="@color/main_text"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerViewDashboard" android:layout_width="match_parent" android:layout_height="0dp" android:clipToPadding="false" android:paddingTop="6dp" android:paddingBottom="36dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintTop_toBottomOf="@id/greetingSection"/>
</androidx.constraintlayout.widget.ConstraintLayout>