<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_global_background"
    android:orientation="vertical">


    <!-- هدر صفحه -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">


        <ImageView
            android:id="@+id/btnInitialPaymentBack"
            style="@style/AppBackButton"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true" />


        <TextView
            android:id="@+id/tvInitialPaymentToolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="عضویت سالانه"
            android:textColor="@color/title_blue"
            android:textSize="21sp"
            android:textStyle="bold" />

    </RelativeLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">


            <!-- لوگوی آموزشگاه -->
            <ImageView
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:contentDescription="@null"
                android:src="@drawable/final50cm" />


            <!-- عنوان اصلی -->
            <TextView
                android:id="@+id/tvInitialPaymentTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="حق عضویت سالانه دانش‌آموز"
                android:textColor="@color/main_text"
                android:textSize="20sp"
                android:textStyle="bold" />


            <!-- توضیح -->
            <TextView
                android:id="@+id/tvInitialPaymentDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="برای استفاده از سامانه آموزشگاه، عضویت سالانه حساب خود را فعال کنید."
                android:textColor="@color/sub_text"
                android:textSize="13sp" />


            <!--
                فقط در زمان تست Sandbox از طریق Kotlin
                قابل نمایش است.
                در Production کاملاً مخفی خواهد بود.
            -->
            <TextView
                android:id="@+id/tvInitialPaymentEnvironment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_unified_info_badge"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text=""
                android:textColor="@color/title_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />


            <!-- کارت پرداخت -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/back_button_stroke"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="22dp">


                    <!-- عنوان مبلغ -->
                    <TextView
                        android:id="@+id/tvInitialPaymentAmountLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مبلغ عضویت یک‌ساله"
                        android:textColor="@color/sub_text"
                        android:textSize="14sp" />


                    <!-- مبلغ -->
                    <TextView
                        android:id="@+id/tvInitialPaymentAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="۱۵۰٬۰۰۰ تومان"
                        android:textColor="@color/title_blue"
                        android:textSize="28sp"
                        android:textStyle="bold" />


                    <!-- وضعیت -->
                    <TextView
                        android:id="@+id/tvInitialPaymentStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="در حال بررسی وضعیت عضویت..."
                        android:textColor="@color/main_text"
                        android:textSize="14sp" />


                    <!-- دکمه پرداخت -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartInitialPayment"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="22dp"
                        android:text="پرداخت حق عضویت"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/brand_orange"
                        app:cornerRadius="12dp" />


                    <!-- بررسی وضعیت -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckInitialPayment"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:text="بررسی وضعیت پرداخت"
                        android:textColor="@color/title_blue"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/title_blue" />


                    <ProgressBar
                        android:id="@+id/progressInitialPayment"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginTop="16dp"
                        android:visibility="gone" />


                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- توضیح اعتبار -->
            <TextView
                android:id="@+id/tvInitialPaymentFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="پس از پرداخت موفق، حساب شما به مدت یک سال فعال خواهد بود. پس از پایان اعتبار، برای ادامه استفاده از سامانه فقط تمدید عضویت سالانه لازم است."
                android:textColor="@color/sub_text"
                android:textSize="12sp" />


        </LinearLayout>

    </ScrollView>

</LinearLayout>