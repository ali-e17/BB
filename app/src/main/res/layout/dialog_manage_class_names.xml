<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <TextView
        style="@style/ClassFormLabel"
        android:layout_marginTop="0dp"
        android:text="نام جدید" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutNewClassName"
        style="@style/ClassFormOutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="مثلاً Kids: Pockets 4A">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNewClassName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical|right"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="100"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/main_text"
            android:textDirection="firstStrong" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddClassName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="افزودن به فهرست"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        app:backgroundTint="@color/brand_orange"
        app:cornerRadius="12dp" />

    <TextView
        style="@style/ClassFormLabel"
        android:layout_marginTop="18dp"
        android:text="نام‌های موجود" />

    <ProgressBar
        android:id="@+id/progressClassNames"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="12dp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/classNameListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
