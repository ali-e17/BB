<?xml version='1.0' encoding='UTF-8'?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape android:shape="oval">
      <solid android:color="@color/back_button_pressed"/>
      <stroke android:width="1dp" android:color="@color/title_blue"/>
    </shape>
  </item>
  <item android:state_focused="true">
    <shape android:shape="oval">
      <solid android:color="@color/back_button_pressed"/>
      <stroke android:width="2dp" android:color="@color/title_blue"/>
    </shape>
  </item>
  <item>
    <shape android:shape="oval">
      <solid android:color="@color/back_button_background"/>
      <stroke android:width="1dp" android:color="@color/back_button_stroke"/>
    </shape>
  </item>
</selector>
