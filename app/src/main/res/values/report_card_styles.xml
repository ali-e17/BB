<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ReportInfoRowCompact">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layoutDirection">ltr</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="ReportInfoLabelCompact">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:maxLines">2</item>
        <item name="android:paddingStart">5dp</item>
        <item name="android:paddingEnd">3dp</item>
        <item name="android:textColor">#52657D</item>
        <item name="android:textSize">8sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ReportInfoValueCompact">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:breakStrategy">simple</item>
        <item name="android:gravity">center_vertical|right</item>
        <item name="android:hyphenationFrequency">none</item>
        <item name="android:maxLines">2</item>
        <item name="android:paddingStart">3dp</item>
        <item name="android:paddingEnd">5dp</item>
        <item name="android:textColor">#111827</item>
        <item name="android:textDirection">firstStrong</item>
        <item name="android:textAlignment">viewEnd</item>
        <item name="android:textSize">8.5sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ReportInfoDividerCompact">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#E5E7EB</item>
    </style>

</resources>
