<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Authentication/session identity. -->
    <exclude domain="sharedpref" path="LocalAppPrefs.xml" />

    <!-- Locally cached students/teachers/classes/history can contain identity data. -->
    <exclude domain="sharedpref" path="AppDatabasePrefs.xml" />

    <!-- Ciphertext is device-bound; never restore it onto another device. -->
    <exclude domain="sharedpref" path="SecureSessionPrefs.xml" />
</full-backup-content>
